{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "romacode",
  "description": "AI-powered development tool",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --cwd packages/cli src/index.ts",
    "dev:live": "sh -c 'ROMACODE_TUI_CHANNEL=dev ROMACODE_PASSWORD=\"$(romacode service get password)\" exec bun run dev \"$@\" --server \"$(romacode service status)\"' --",
    "dev:vite": "bun run --cwd packages/cli --conditions=browser dev/vite.ts",
    "dev:vite:live": "sh -c 'ROMACODE_TUI_CHANNEL=dev ROMACODE_PASSWORD=\"$(romacode service get password)\" exec bun run dev:vite \"$@\" --server \"$(romacode service status)\"' --",
    "lint": "oxlint && ast-grep scan -c script/ast-grep/gui-plugins/sgconfig.yml && bun script/sdk-docs.ts",
    "lint:changed": "bun script/lint-changed.ts",
    "lint:effect-patterns": "ast-grep scan -c script/ast-grep/sgconfig.yml packages/util/src packages/core/src packages/server/src packages/protocol/src packages/cli/src",
    "lint:effect-simplifications": "ast-grep scan -c script/ast-grep/effect-simplifications/sgconfig.yml --off=unused-suppression packages",
    "test:lint-rules": "ast-grep test -c script/ast-grep/sgconfig.yml",
    "test:effect-simplification-rules": "ast-grep test -c script/ast-grep/effect-simplifications/sgconfig.yml",
    "typecheck": "bun turbo typecheck --concurrency=3",
    "typecheck:tsc": "bun turbo typecheck:tsc --concurrency=3",
    "check": "bun run lint && bun run typecheck",
    "typecheck:profile": "bun script/profile-typecheck.ts",
    "typecheck:profile:packages": "bun script/profile-typecheck-packages.ts",
    "pack": "bun run script/pack.ts",
    "upgrade-opentui": "bun run script/upgrade-opentui.ts",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "sso": "aws sso login --sso-session=romacode --no-browser",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/vendor/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.1",
      "@effect/platform-node": "4.0.1",
      "@effect/platform-node-shared": "4.0.1",
      "@effect/sql-sqlite-bun": "4.0.1",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.4.3",
      "@types/cross-spawn": "6.0.6",
      "@opentui/core": "0.7.0",
      "@opentui/keymap": "0.7.0",
      "@opentui/solid": "0.7.0",
      "@standard-schema/spec": "1.1.0",
      "@kobalte/core": "0.13.13",
      "@types/node": "24.12.2",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@pierre/diffs": "1.6.1",
      "@pierre/highlights": "0.2.0",
      "@solid-primitives/event-listener": "2.4.6",
      "@solid-primitives/resize-observer": "2.2.0",
      "diff": "8.0.4",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-169397b",
      "effect": "4.0.1",
      "fast-check": "4.9.0",
      "cross-spawn": "7.0.6",
      "fuzzysort": "3.1.0",
      "get-east-asian-width": "1.6.0",
      "marked": "18.0.11",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "@typescript/native": "npm:typescript@7.1.0-beta",
      "zod": "4.6.7",
      "remeda": "2.26.0",
      "sst": "4.13.1",
      "solid-list": "0.3.0",
      "string-width": "7.2.0",
      "tailwindcss": "4.1.11",
      "vite": "7.3.6",
      "@solidjs/meta": "0.29.4",
      "solid-js": "1.9.17",
      "solid-sonner": "0.3.1",
      "vite-plugin-solid": "2.11.10",
      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "0.44.0",
    "@romacode/client": "workspace:*",
    "@oxlint/plugins": "1.60.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "@types/react": "19.2.17",
    "@typescript/native": "catalog:",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "solid-js": "catalog:",
    "sst": "catalog:",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "@romacode/plugin": "workspace:*",
    "@romacode/script": "workspace:*",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reddata997327/romacode-cli"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "electron"
  ],
  "overrides": {
    "@opentui/core": "0.7.0",
    "@opentui/keymap": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@effect/platform-node-shared": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "1.4.4",
    "effect": "catalog:",
    "open": "11.0.4"
  }
}
